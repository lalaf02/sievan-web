# The archive lives in Supabase. There is no local fallback: a build without these
# fails loudly rather than quietly rendering stale data.
#
# Local:  copy this file to .env.local and fill both in.
# Vercel: project `sievan-archive`, team `lalas-projects-d5f6f75a` (NOT the personal
#         scope) -> Settings -> Environment Variables, for Production, Preview and
#         Development.

SUPABASE_URL=https://hougbsutgpngyshrixff.supabase.co

# The SECRET key (sb_secret_... , shown as service_role), not the publishable one.
# The build reads the whole archive, including rows a curator has not finished
# reviewing, and row-level security grants `anon` nothing at all.
#
# Build-time only. It is never sent to a browser: the published site is static HTML
# and never contacts this database.
SUPABASE_SECRET_KEY=
