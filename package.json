{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/check-data.mjs && node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-quotes.mjs",
    "predev": "npm run data",
    "dev": "next dev",
    "prebuild": "npm run data",
    "build": "next build",
    "postbuild": "node scripts/check-export.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "db:seed": "node scripts/seed-supabase.mjs",
    "db:export": "node scripts/export-seeds.mjs",
    "db:media": "node scripts/upload-media.mjs",
    "db:parity": "node scripts/check-parity.mjs",
    "design:sync": "rsync -a --delete --exclude .git --exclude node_modules ../sievan-design/ node_modules/@sievan/design/"
  },
  "dependencies": {
    "@sievan/design": "git+https://github.com/lalaf02/sievan-design.git#v1.1.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
